# UniFlow AI environment template
APP_NAME=UniFlow AI
APP_ENV=development
LOG_LEVEL=INFO
LOG_PATH=logs/uniflow.jsonl

# Runtime persistence
DATABASE_PATH=data/uniflow.sqlite
CHECKPOINT_DATABASE_PATH=data/checkpoints.sqlite
MAX_REPLANS=3

# LLM configuration
# Safe offline/default mode: deterministic coordinator path, no external API call.
LLM_PROVIDER=not_configured
LLM_MODEL=

# For the rubric's live LLM function-calling evidence, change to:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-5.5
# OPENAI_API_KEY=your_real_key_here
# Never commit the real key. Keep it only in local .env / deployment secrets.
OPENAI_API_KEY=

# Checkpoint deserialization hardening. The application also enforces this at runtime.
LANGGRAPH_STRICT_MSGPACK=true
